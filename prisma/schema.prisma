datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
  password String
}
